# Host + build profile: every dependency is compiled with the STATIC CRT
# (/MT), which is what the driver facade needs so a print driver package
# does not depend on the VC++ redistributable.
#
# Use it for BOTH host and build profile:  -pr:a profiles/win-x64-static-release
#
# compiler.version=191 is MSVC 19.1x (Visual Studio 2017), the version
# whose v141 toolset matches the rest of this project.
[settings]
arch=x86_64
build_type=Release
compiler=msvc
compiler.cppstd=14
compiler.runtime=static
compiler.version=191
os=Windows

# generator=Ninja matters: without it conan's toolchain assumes the
# default Visual Studio generator and force-sets
# CMAKE_GENERATOR_PLATFORM/TOOLSET, which makes the later `cmake -G Ninja`
# configure fail with "Ninja does not support platform specification".
#
# Do NOT add tools.microsoft:winsdk_version here. That conf makes conan
# emit the CMAKE_GENERATOR_PLATFORM block unconditionally (see
# GenericSystemBlock in conan's blocks.py), which has the same
# Ninja-incompatible effect. It was only ever needed to retarget
# libjpeg's bundled jpeg.sln off the absent 8.1 SDK, and libjpeg is now
# disabled (see conanfile.py's podofo-local options).
[conf]
tools.cmake.cmaketoolchain:generator=Ninja

# NOTE: a [buildenv] PATH+= entry was tried here to force Meson to find the
# MSVC linker (freetype is built with Meson, and Meson's guess_win_linker
# crashes if a foreign link.exe such as Git's coreutils 'link' shadows it).
# Conan 2.18 emits the entries space-separated instead of ';'-separated on
# Windows, which corrupts PATH and hides meson itself, so the fix lives in
# pdflib-build-env.cmd instead: it prepends a shim directory holding the
# real cl/link/rc/mt to PATH before conan runs.
