; pdfx.def - authoritative export list for pdfx.dll.
;
; pdfx is the libharu-style C API with the prefix swapped: HPDF_New becomes
; PDFX_New, HPDF_AddPage becomes PDFX_AddPage, and so on. The surface is
; libharu 2.4.4's public hpdf.h; the implementation is pdfx_compat.c, which
; sits on the backend-agnostic pdf_* core (libharu or PoDoFo underneath,
; selected at run time by PDFX_SetBackend / the PDFLIB_BACKEND environment
; variable). Nothing here calls libharu directly.
;
; Names are exported verbatim (undecorated) on both x86 and x64, so
; GetProcAddress / ctypes / JNA / P-Invoke / FFI all resolve them the same
; way, and a C program built against pdfx/include/pdfx.h links the import
; library without seeing a single decorated symbol.
;
; LIBRARY must match the DLL output name exactly, otherwise link.exe emits
; LNK4070 and can emit the wrong file name.
LIBRARY pdfx

EXPORTS
    PDFX_3DAnnotExData_Set3DMeasurement
    PDFX_3DC3DMeasure_SetProjectionAnotation
    PDFX_3DC3DMeasure_SetText
