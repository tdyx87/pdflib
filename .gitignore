# build dirs
build/
out/

# downloaded reference sources used for offline syntax checks
.reference/

# local preview copies of built PDFs
tools/pdf-preview/*.pdf

# conan
conan.lock
conanbuild.sh
conanbuild.bat
conanrun.sh
conanrun.bat
graph_info.json

# editors / os
.vs/
.vscode/
*.user
Thumbs.db

# Freebuff workspace state
.freebuff/

# generated per-machine conan preset (points into build/)
CMakeUserPresets.json

# local build/test artifacts
*.7z
streamed-demo.pdf
torn-job.pdf

# MSVC toolchain binaries copied into the tree for sandboxed builds.
# Proprietary Microsoft binaries - never commit these.
.tools/

# install output of tools/run-all-tests.sh (DLL, .lib, staged headers)
dist/

# PDFs the examples and tests write into the repo root. Anchored to the
# root on purpose: sample PDFs kept under docs/ or tests/ still track.
/*.pdf

# local agent workspace state (memory + daily logs)
.workbuddy-ai/
