@echo off
rem Syntax check of the two real backends against real third-party headers.
rem No linking: the third-party binaries cannot be built on this machine
rem (missing Win SDK 8.1 / nasm), but this catches API mismatches inside
rem the backend translation units.
rem
rem PoDoFo check uses the 0.9.7 source tree with a hand-written
rem podofo_config.h stand-in (normally generated by CMake). The check is
rem run both with and without PODOFO_HAVE_OPENSSL to cover the crypto-free
rem build.
setlocal
call "C:\Program Files (x86)\Microsoft Visual Studio\2017\Community\VC\Auxiliary\Build\vcvars64.bat" >nul 2>&1
if errorlevel 1 ( echo [ERR] vcvars64 failed & exit /b 1 )
cd /d E:\github\pdflib

cl /nologo /c /W3 /EHsc /utf-8 ^
  /I. /Ipdflib ^
  /DPDFLIB_BACKEND_LIBHARU_ENABLED /DPDFLIB_BACKEND_PODOFO_ENABLED ^
  /I.reference\haru-src\include ^
  /I.reference\podofo-src\src ^
  /FoNUL ^
  pdflib\backends\pdf_backend_libharu.c
if errorlevel 1 ( echo [FAIL] libharu backend & exit /b 1 )
echo [OK] libharu backend

rem --- podofo 0.9.7, WITHOUT openssl --------------------------------------
cl /nologo /c /W3 /EHsc /utf-8 ^
  /I. /Ipdflib ^
  /DPDFLIB_BACKEND_LIBHARU_ENABLED /DPDFLIB_BACKEND_PODOFO_ENABLED ^
  /I.reference\podofo-0.9.7-src\src ^
  /I.reference\podofo-0.9.7-src ^
  /FoNUL ^
  pdflib\backends\pdf_backend_podofo.cpp
if errorlevel 1 ( echo [FAIL] podofo backend (no openssl) & exit /b 1 )
echo [OK] podofo backend (no openssl)

rem --- podofo 0.9.7, WITH openssl (macros present) -------------------------
cl /nologo /c /W3 /EHsc /utf-8 ^
  /I. /Ipdflib ^
  /DPDFLIB_BACKEND_LIBHARU_ENABLED /DPDFLIB_BACKEND_PODOFO_ENABLED ^
  /DPODOFO_HAVE_OPENSSL ^
  /I.reference\podofo-0.9.7-src\src ^
  /I.reference\podofo-0.9.7-src ^
  /FoNUL ^
  pdflib\backends\pdf_backend_podofo.cpp
if errorlevel 1 ( echo [FAIL] podofo backend (openssl) & exit /b 1 )
echo [OK] podofo backend (openssl)
endlocal
